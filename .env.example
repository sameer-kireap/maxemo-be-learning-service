# Application
APP_NAME="Learning Analytics Service"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL container defaults)
POSTGRES_USER=maxemo
POSTGRES_PASSWORD=maxemo_secret
POSTGRES_DB=learning_analytics

# Database Connection URL — asyncpg scheme required
# For local dev: localhost:5433
# For Docker Compose: postgres:5432
DATABASE_URL=postgresql+asyncpg://maxemo:maxemo_secret@localhost:5433/learning_analytics
